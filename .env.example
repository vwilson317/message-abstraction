# Copy to .env (or export in your shell). All optional.

# Where the server listens. Keep 127.0.0.1: there is no login.
PORT=4310
HOST=127.0.0.1
# Extra host names the server should answer to, comma-separated.
ALLOWED_HOSTS=

# Inbox's own database and imported media.
DATA_DIR=./data

# Largest export the web upload accepts; use `npm run import` for bigger ones.
MAX_UPLOAD_MB=512

# WhatsApp Desktop's data. Defaults to
# ~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared on a Mac.
WHATSAPP_CONTAINER=
# How often to check it for changes, in milliseconds.
WHATSAPP_POLL_MS=1500

# Only accept captures from this extension (its id is on chrome://extensions).
EXTENSION_ID=
