# Copy to .env (or export in your shell). All optional.

# Where the API listens. Keep 127.0.0.1 unless you add authentication in front.
PORT=4310
HOST=127.0.0.1
# Extra host names the API should answer to, comma-separated (e.g. a Tailscale name).
ALLOWED_HOSTS=

# SQLite database, media and connector credentials live here.
DATA_DIR=./data

# Largest export the web upload accepts; use `npm run import` for bigger ones.
MAX_UPLOAD_MB=512

# Ask the phone for full history when linking WhatsApp (slower first sync).
WHATSAPP_SYNC_FULL_HISTORY=true
# Auto-download images, stickers and voice notes up to this size for live messages.
WHATSAPP_AUTO_DOWNLOAD_MB=16
# Baileys log level (silent, error, warn, info, debug) for troubleshooting.
WHATSAPP_LOG_LEVEL=silent
