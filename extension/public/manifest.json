{
  "manifest_version": 3,
  "name": "Inbox companion",
  "version": "0.1.0",
  "description": "Shows insights beside the Instagram conversation you have open. Reads the page only; everything stays on your computer.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open the Inbox panel" },
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
